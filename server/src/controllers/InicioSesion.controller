/*Estado HTTP	Significado
  200	        Inicio de sesión exitoso.
  400           La solicitud está incompleta o es inválida.
  401           Las credenciales no son válidas.
  423         	La cuenta está bloqueada temporalmente.
  500           Ocurrió un error interno del servidor.*/

const { PrismaClient } = require('@prisma/client');

const prisma = new PrismaClient();
const intentosFallidos = new Map();
const TIEMPO_BLOQUEO_MS = 15 * 60 * 1000;

// Espera req.body con { id, contraseña }. Se asume el modelo Prisma `usuario`
// con los campos `id`, `contraseña` y `rol`.
const iniciarSesion = async (req, res) => {
	const { id, contraseña } = req.body || {};

	if (id === undefined || id === null || contraseña === undefined) {
        //El console log solo esta para probar, despues en la implementacion final se deberia borrar, debido a que, el return
        //Ya devuelve el mensaje de error al front end con el tipo de error, y el mensaje que debera mostrar el front del usuario.
		console.log('Debe ingresar un id y una contraseña.');

		return res.status(400).json({ mensaje: 'Debe ingresar un id y una contraseña.' });
	}

	const claveId = String(id);
	const ahora = Date.now();
	const registro = intentosFallidos.get(claveId);

	if (registro && registro.bloqueadoHasta > ahora) {
        //El console log solo esta para probar, despues en la implementacion final se deberia borrar, debido a que, el return
        //Ya devuelve el mensaje de error al front end con el tipo de error, y el mensaje que debera mostrar el front del usuario.
		console.log('Cuenta bloqueada momentáneamente.');

		return res.status(423).json({ mensaje: 'Cuenta bloqueada momentáneamente.' });
	}
	if (registro?.bloqueadoHasta && registro.bloqueadoHasta <= ahora) {
		intentosFallidos.delete(claveId);
	}

	try {
		const usuario = await prisma.usuario.findUnique({ where: { id } });
        //En esta comparacion de aca estamos suponiendo que guardamos en texto plano la contraseña
        //Si mas adelante almaenamos la constraseña con algun encriptamiento, aca habria que cambiar la comparacion para desencriptar.
		if (!usuario || usuario.contraseña !== contraseña) {
			const intentos = (intentosFallidos.get(claveId)?.intentos || 0) + 1;
            //Esto es para usarlo despues en el front end.
			if (intentos >= 3) {
				intentosFallidos.set(claveId, {
					intentos,
					bloqueadoHasta: ahora + TIEMPO_BLOQUEO_MS,
				});
                //El console log solo esta para probar, despues en la implementacion final se deberia borrar, debido a que, el return
                //Ya devuelve el mensaje de error al front end con el tipo de error, y el mensaje que debera mostrar el front del usuario.
				console.log('Cuenta bloqueada momentáneamente tras 3 intentos fallidos.');
                
				return res.status(423).json({ mensaje: 'Cuenta bloqueada momentáneamente.' });
			}

			intentosFallidos.set(claveId, { intentos });
			const mensaje = usuario ? 'contraseña incorrecta' : 'id invalido';
			//El console log solo esta para probar, despues en la implementacion final se deberia borrar, debido a que, el return
			//Ya devuelve el mensaje de error al front end con el tipo de error, y el mensaje que debera mostrar el front del usuario.
			console.log(mensaje);

			return res.status(401).json({ mensaje });
		}

		intentosFallidos.delete(claveId);
		console.log(`Inicio de sesión exitoso. Rol: ${usuario.rol}`);
		return res.status(200).json({ mensaje: 'Inicio de sesión exitoso.', rol: usuario.rol });
	} catch (error) {
        //El console log solo esta para probar, despues en la implementacion final se deberia borrar, debido a que, el return
        //Ya devuelve el mensaje de error al front end con el tipo de error, y el mensaje que debera mostrar el front del usuario.
		console.error('Error al iniciar sesión:', error);

		return res.status(500).json({ mensaje: 'Error interno al iniciar sesión.' });
	}
};

//Permitimos que otros archivos puedan implementar eta funcion controlador
module.exports = iniciarSesion;

